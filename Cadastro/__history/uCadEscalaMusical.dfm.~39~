  inherited qryPrincipal: TFDQuery
    SQL.Strings = (
      '    SELECT e.escalaId,'
      '           e.nome,'
      '           t.nome AS tonalidade,'
      '           te.nome AS tipoEscala,'
      '           e.descricao,'
      '           e.caminhoArquivo,'
      '           e.nomeArquivo,'
      '           e.conteudoArquivo'
      '    FROM escalas e'
      '    INNER JOIN tonalidades t ON t.tonalidadeId = e.tonalidadeId'
      '    INNER JOIN tipoEscala te ON te.tipoEscalaId = e.tipoId'
      '    ORDER BY e.nome')
