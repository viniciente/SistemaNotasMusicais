  object qryArquivos: TFDQuery
    Active = True
    Connection = dmDados.FDConexao
    SQL.Strings = (
      '        SELECT e.escalaId,'
      '               e.nome,'
      '               t.nome AS tonalidade,'
      '               te.nome AS tipoEscala,'
      '               e.listaNota,'
      '               e.descricao,'
      '               e.caminhoArquivo,'
      '               e.nomeArquivo,'
      '               e.conteudoArquivo'
      '     FROM escalas e'
      '     INNER JOIN tonalidades t ON t.tonalidadeId = e.tonalidadeId'
      '     INNER JOIN tipoEscala te ON te.tipoEscalaId = e.tipoId'
      '     ORDER BY e.nome')
    Left = 525
    Top = 1
